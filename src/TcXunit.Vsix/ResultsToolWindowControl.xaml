<UserControl x:Class="TcXunit.Vsix.ResultsToolWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             d:DesignHeight="400" d:DesignWidth="350">
    <!--
      Row 2 (the former WPF TreeView) is now a WebView2 loading Resources/results.html,
      which itself loads vsix-tokens.css/vsix-shell.css/results.css; see
      docs/design-system.html section 8 and TcXunit-1tt.1. RunButton/StatusText stay
      native WPF for now; results-tree rendering into the WebView2 is TcXunit-1tt.2.
      WebView2 fills its row edge-to-edge (no Margin) so the panel's own dark chrome
      reaches the tool window's borders, matching TcAgentPlugin's chat panel.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Button Grid.Row="0" x:Name="RunButton" Content="Run tests (tcxunit)" HorizontalAlignment="Left"
                Padding="8,4" Margin="8,8,8,8" Click="RunButton_Click" />

        <TextBlock Grid.Row="1" x:Name="StatusText" Margin="8,0,8,8" TextWrapping="Wrap" />

        <wv2:WebView2 Grid.Row="2" x:Name="Browser" />
    </Grid>
</UserControl>
