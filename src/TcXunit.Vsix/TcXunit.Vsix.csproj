    <Reference Include="System.Runtime.CompilerServices.Unsafe">
      <HintPath>..\..\packages\System.Runtime.CompilerServices.Unsafe.6.0.0\lib\net461\System.Runtime.CompilerServices.Unsafe.dll</HintPath>
    </Reference>
    <Reference Include="System.Threading.Tasks.Extensions">
      <HintPath>..\..\packages\System.Threading.Tasks.Extensions.4.5.4\lib\net461\System.Threading.Tasks.Extensions.dll</HintPath>
    </Reference>
    <!--
      TcXunit-qwh.4: the closure above was still short two entries. Loading
      System.Text.Json.6.0.10's net461 asset with ReflectionOnlyLoadFrom shows
      its AssemblyRef table also names Microsoft.Bcl.AsyncInterfaces
      (6.0.0.0) and System.ValueTuple (4.0.3.0) - the .NETFramework4.6.1
      dependency group in its own .nuspec lists exactly these two packages
      (at 6.0.0 / 4.5.0 respectively) alongside the ones already referenced
      above. Neither was ever added here, so under TcXaeShell's devenv
      (CLR v4.0.30319, no NuGet-generated app.config to fall back on) the
      loader's OnAssemblyResolve had nothing to find for
      Microsoft.Bcl.AsyncInterfaces and threw FileNotFoundException resolving
      System.Text.Json.dll's own static dependencies - not a version
      mismatch, the files were simply never restored/deployed. Confirmed by
      reflecting both packages' net461 lib assemblies: they report exactly
      6.0.0.0 and 4.0.3.0, i.e. bit-for-bit what System.Text.Json.dll asks
      for, so (unlike TcAgent.csproj's ProvideBindingRedirection entries for
      this same package) no binding redirect is needed here - only the
      missing reference and deployment.
    -->
    <Reference Include="Microsoft.Bcl.AsyncInterfaces">
      <HintPath>..\..\packages\Microsoft.Bcl.AsyncInterfaces.6.0.0\lib\net461\Microsoft.Bcl.AsyncInterfaces.dll</HintPath>
    </Reference>
    <Reference Include="System.ValueTuple">
