  <!--
    TcXunit-qwh.4: the closure above was incomplete. System.Text.Json.6.0.10's
    net461 asset's own AssemblyRef table (confirmed via ReflectionOnlyLoadFrom)
    also names Microsoft.Bcl.AsyncInterfaces (6.0.0.0) and System.ValueTuple
    (4.0.3.0) - both entirely absent from this file, so neither package was ever
    restored, referenced, or copied to the VSIX output. That is what
    TcXaeShell's event log reported as an OnAssemblyResolve failure for
    Microsoft.Bcl.AsyncInterfaces plus a FileNotFoundException out of
    System.Text.Json.dll: not a version mismatch, a plain missing file.
  -->
  <package id="Microsoft.Bcl.AsyncInterfaces" version="6.0.0" targetFramework="net461" />
  <package id="System.ValueTuple" version="4.5.0" targetFramework="net461" />
