<UserControl x:Class="xStunit.Vsix.ResultsToolWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             d:DesignHeight="400" d:DesignWidth="350">
    <!--
      Row 1 is a WebView2 loading Resources/results.html, which pulls in
      vsix-tokens.css, vsix-shell.css and results.css; see docs/design-system.html
      section 8. It fills its row edge to edge, with no Margin, so the page's own
      chrome reaches the tool window's borders instead of framing itself in WPF
      background.

      There is no native WPF button here: design-system.html's toolbar has exactly one
      primary action, and that lives inside the page as #runButton, driven over
      window.chrome.webview.postMessage and CoreWebView2.WebMessageReceived. Row 0's
      StatusText is the host-level fallback for the errors the page cannot show at all
      (WebView2 failing to initialize, xstunit.json missing); running state and run
      results are pushed into the page instead. Note that this comment avoids the
      double hyphen used as an aside elsewhere in the codebase, since XML comments may
      not contain one; semicolons and parens stand in.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="StatusText" Margin="8,8,8,8" TextWrapping="Wrap" Visibility="Collapsed" />

        <wv2:WebView2 Grid.Row="1" x:Name="Browser" />
    </Grid>
</UserControl>
