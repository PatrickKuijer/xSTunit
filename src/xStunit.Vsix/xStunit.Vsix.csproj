    <!--
      XstunitConfig.cs, XstunitProcessRunner.cs, and ResultsToolWindowControl.xaml.cs
      serialize with System.Text.Json rather than a .NET Framework only API such as
      JavaScriptSerializer, so that the TestRunner/ types stay source-linkable into
      tests/xStunit.Vsix.Tests, which targets net8.0. These are the same package
      versions TcAgentPlugin/src/TcAgent ships and proves work under XAE Shell's
      devenv: System.Text.Json's net461 asset plus its own net461-compatible
      dependency closure. Referenced by bare name plus HintPath, unlike the WebView2
      references above, because only some of these packages' exact assembly identities
      are independently confirmed; resolving off the file avoids asserting a wrong
      guessed Version/PublicKeyToken for the rest.
    -->
    <Reference Include="System.Text.Json">
      <HintPath>..\..\packages\System.Text.Json.6.0.10\lib\net461\System.Text.Json.dll</HintPath>
    </Reference>
    <Reference Include="System.Text.Encodings.Web">
      <HintPath>..\..\packages\System.Text.Encodings.Web.6.0.0\lib\net461\System.Text.Encodings.Web.dll</HintPath>
    </Reference>
    <Reference Include="System.Buffers">
      <HintPath>..\..\packages\System.Buffers.4.5.1\lib\net461\System.Buffers.dll</HintPath>
    </Reference>
    <Reference Include="System.Memory">
      <HintPath>..\..\packages\System.Memory.4.5.4\lib\net461\System.Memory.dll</HintPath>
    </Reference>
    <Reference Include="System.Numerics.Vectors">
      <HintPath>..\..\packages\System.Numerics.Vectors.4.5.0\lib\net46\System.Numerics.Vectors.dll</HintPath>
    </Reference>
    <Reference Include="System.Runtime.CompilerServices.Unsafe">
      <HintPath>..\..\packages\System.Runtime.CompilerServices.Unsafe.6.0.0\lib\net461\System.Runtime.CompilerServices.Unsafe.dll</HintPath>
    </Reference>
    <Reference Include="System.Threading.Tasks.Extensions">
      <HintPath>..\..\packages\System.Threading.Tasks.Extensions.4.5.4\lib\net461\System.Threading.Tasks.Extensions.dll</HintPath>
    </Reference>
    <!--
      Also named in System.Text.Json 6.0.10's net461 AssemblyRef table, so they
      complete the closure above. Without them, XAE Shell's devenv (which has no
      NuGet-generated app.config to fall back on) throws FileNotFoundException
      resolving System.Text.Json.dll's own static dependencies. Their assembly
      versions are exactly the ones System.Text.Json asks for, 6.0.0.0 and
      4.0.3.0, so no binding redirect is needed here; only the reference and the
      matching Content entries below.
    -->
    <Reference Include="Microsoft.Bcl.AsyncInterfaces">
      <HintPath>..\..\packages\Microsoft.Bcl.AsyncInterfaces.6.0.0\lib\net461\Microsoft.Bcl.AsyncInterfaces.dll</HintPath>
    </Reference>
    <Reference Include="System.ValueTuple">
