<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_FailingLineHelper" Id="{c4d5e6f7-0004-4a1a-8b1b-000000000001}" SpecialFunc="None">
    <Declaration><![CDATA[(*
    TcXunit interpreter fixture (TcXunit-p3t.4). Faults from a deliberately
    NOT-first line of a METHOD body, several lines into a file whose ST
    element is nowhere near line 1, so a failure log that forgets
    BodyStartLine - or adds it naively and lands one line off - is caught.
*)
FUNCTION_BLOCK FB_FailingLineHelper]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ThrowsFromNestedCall" Id="{c4d5e6f7-0004-4a1a-8b1b-000000000002}">
      <Declaration><![CDATA[METHOD PUBLIC ThrowsFromNestedCall
VAR
	spin : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[spin := 1;
spin := spin + 1;

(* The statement below is the one the failure log must name. *)
ThisMethodDoesNotExist();

spin := spin + 1;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
