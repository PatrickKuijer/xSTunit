<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_FailingLineTests" Id="{c4d5e6f7-0004-4a1a-8b1b-000000000003}" SpecialFunc="None">
    <Declaration><![CDATA[(*
    Interpreter fixture. Suite whose test method faults inside
    FB_FailingLineHelper: the reported location must be the INNERMOST body's
    POU/method/line, not this suite's call site.
*)
FUNCTION_BLOCK FB_FailingLineTests EXTENDS TcUnit.FB_TestSuite
VAR
	helper : FB_FailingLineHelper;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[FaultsDeepInAHelper();]]></ST>
    </Implementation>
    <Method Name="FaultsDeepInAHelper" Id="{c4d5e6f7-0004-4a1a-8b1b-000000000004}">
      <Declaration><![CDATA[METHOD PRIVATE FaultsDeepInAHelper
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('FaultsDeepInAHelper');

(* Caller-side call site: NOT the line the failure log should name. *)
helper.ThrowsFromNestedCall();

TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
