<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <DUT Name="ST_TrailingPadding" Id="{c0de1a70-0000-4000-8000-000000000006}">
    <Declaration><![CDATA[// Layout checklist: five bytes of content, and the question of whether the
// declared size is 5 or 8. Also the element type of ST_ArrayStride, where the
// same three bytes decide the stride.
TYPE ST_TrailingPadding :
STRUCT
	wide : DINT;
	tail : BYTE;
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>
