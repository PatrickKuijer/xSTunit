<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <Itf Name="I_AxisBase" Id="{5e4501d0-0023-4d19-9a41-000000000001}">
    <Declaration><![CDATA[(*
    The drive contract a conveyor run is commanded through.

    This is the slice of the axis contract a conveyor actually uses, and
    nothing beyond it: power the drive, command a velocity, acknowledge a
    fault, and read back whether a fault is standing and how fast the belt is
    going. The full stated contract also carries Home / MoveAbsolute /
    MoveRelative and positional feedback, which a continuous belt has no use
    for - a conveyor never asks where it is, only how fast it is going.

    A consumer commands EVERY scan. MoveVelocity is a level, not a one-shot:
    the equipment module re-asserts its demand each cycle, so a drive that
    resets, or a link that drops and returns, converges back on the commanded
    speed instead of waiting for a fresh edge.
*)
INTERFACE I_AxisBase]]></Declaration>
    <Method Name="Enable" Id="{5e4501d0-0023-4d19-9a41-000000000002}">
      <Declaration><![CDATA[// Requests drive power. Returns whether the drive is live yet, which is not
// the same as the request having been accepted, so a caller that needs power
// re-asserts rather than assuming.
METHOD Enable : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="MoveVelocity" Id="{5e4501d0-0023-4d19-9a41-000000000004}">
      <Declaration><![CDATA[METHOD MoveVelocity : BOOL
VAR_INPUT
	// Target speed in drive units. Zero is a legitimate command and means
	// "hold at standstill under power", not "release the axis".
	Velocity : LREAL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="Reset" Id="{5e4501d0-0023-4d19-9a41-000000000005}">
      <Declaration><![CDATA[// Acknowledges a drive fault. Clears Error only if whatever raised it has
// gone away; a standing fault survives the acknowledgement.
METHOD Reset : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Property Name="Error" Id="{5e4501d0-0023-4d19-9a41-000000000008}">
      <Declaration><![CDATA[// A drive-side fault is standing. Held until Reset is called AND the cause
// has cleared, so a consumer may treat it as a level rather than an event.
PROPERTY Error : BOOL]]></Declaration>
      <Get Name="Get" Id="{5e4501d0-0023-4d19-9a41-000000000009}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ActualVelocity" Id="{5e4501d0-0023-4d19-9a41-00000000000c}">
      <Declaration><![CDATA[// Measured speed in the same units MoveVelocity is commanded in.
PROPERTY ActualVelocity : LREAL]]></Declaration>
      <Get Name="Get" Id="{5e4501d0-0023-4d19-9a41-00000000000d}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[]]></ST>
        </Implementation>
      </Get>
    </Property>
  </Itf>
</TcPlcObject>
