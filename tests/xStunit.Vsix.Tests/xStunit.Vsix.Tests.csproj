<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    src/xStunit.Vsix is a classic packages.config VSSDK project (net472,
    referencing WebView2/EnvDTE/VS SDK assemblies) that does not build outside
    Visual Studio on Windows, so a ProjectReference to it would break this
    project everywhere else, CI included; see src/xStunit.Vsix/README.md and
    docs/design-system.html's Testing Decisions. The files below are
    source-linked instead: they are the TestRunner/ types with zero VS
    SDK/WebView2 dependency, and they serialize with System.Text.Json, which
    resolves on both net472 and net8.0.

    XstunitProcessRunner.cs is deliberately not linked. RunAsync shells out via
    System.Diagnostics.Process, and its only pure logic (argument construction)
    lives in XstunitArgumentBuilder.cs, which is linked.
  -->
  <ItemGroup>
    <Compile Include="..\..\src\xStunit.Vsix\TestRunner\XstunitModels.cs" Link="TestRunner\XstunitModels.cs" />
    <Compile Include="..\..\src\xStunit.Vsix\TestRunner\XstunitConfig.cs" Link="TestRunner\XstunitConfig.cs" />
    <Compile Include="..\..\src\xStunit.Vsix\TestRunner\XstunitArgumentBuilder.cs" Link="TestRunner\XstunitArgumentBuilder.cs" />
    <Compile Include="..\..\src\xStunit.Vsix\TestRunner\XstunitEventStream.cs" Link="TestRunner\XstunitEventStream.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
